# ==============================================================================
# Multi-Stage Backend Dockerfile for AgentApply AI (Playwright + FastAPI)
# Targets:
#   - crewai:    Installs CrewAI multi-agent dependencies
#   - langgraph: Installs LangGraph state-graph dependencies
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Base Runtime Environment
# ------------------------------------------------------------------------------
FROM python:3.11-slim-bookworm AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DEBIAN_FRONTEND=noninteractive \
    HEADLESS=true \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PORT=8002

WORKDIR /app

# Install system utilities & SSL certificates required by Playwright & Chrome
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    wget \
    gnupg \
    ca-certificates \
    procps \
    libglib2.0-0 \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxkbcommon0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Upgrade pip and copy base requirements
RUN pip install --no-cache-dir --upgrade pip setuptools wheel
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

# Install Playwright Chromium and ensure system libraries are satisfied
RUN mkdir -p /ms-playwright && \
    playwright install --with-deps chromium

# ------------------------------------------------------------------------------
# Stage 2: CrewAI Agent Variant
# ------------------------------------------------------------------------------
FROM base AS crewai

ENV AGENT_FRAMEWORK=crewai

COPY requirements-crewai.txt /app/requirements-crewai.txt
RUN pip install --no-cache-dir -r /app/requirements-crewai.txt

# Copy application source code
COPY . /app

# Create persistent storage directories
RUN mkdir -p /app/logs /app/data && \
    chmod -R 777 /app/logs /app/data /ms-playwright

EXPOSE 8002

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8002/api/stats || exit 1

CMD ["uvicorn", "dashboard.server:app", "--host", "0.0.0.0", "--port", "8002"]

# ------------------------------------------------------------------------------
# Stage 3: LangGraph Agent Variant
# ------------------------------------------------------------------------------
FROM base AS langgraph

ENV AGENT_FRAMEWORK=langgraph

COPY requirements-langgraph.txt /app/requirements-langgraph.txt
RUN pip install --no-cache-dir -r /app/requirements-langgraph.txt

# Copy application source code
COPY . /app

# Create persistent storage directories
RUN mkdir -p /app/logs /app/data && \
    chmod -R 777 /app/logs /app/data /ms-playwright

EXPOSE 8002

HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8002/api/stats || exit 1

CMD ["uvicorn", "dashboard.server:app", "--host", "0.0.0.0", "--port", "8002"]
